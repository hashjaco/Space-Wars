*.class
target/
dist/

# IDEs
.idea/
*.iml
.vscode/

# macOS
.DS_Store

# Relay worker: installed deps and the types wrangler regenerates from wrangler.jsonc.
server/node_modules/
server/worker-configuration.d.ts
server/.wrangler/

# Press kit video. The stills and plates are committed; the trailer is not.
#
# Not because of its size today but because of its size repeated: video delta-compresses no better
# than the PNGs "The one long-term cost" in docs/ROADMAP.md is about, and unlike the sprites it is
# not a build input, cannot be checked by CI, and is re-cut whenever the marketing changes. Every
# re-cut would append another full copy to a history that is already 280 MB. It ships as a Release
# asset instead -- see docs/press/README.md.
docs/press/trailer/*.mp4

# The per-clip captures the trailer is joined from. Gigabytes, and trailer.sh rebuilds them.
docs/press/trailer/clips/
tools/sprixen/.project-id
tools/sprixen/out/
tools/sprixen/.vfx-ids.json
tools/sprixen/.gen*
server/.dev.vars
# Sprixen job ids and the CG pipeline's state; the art they produce is what gets committed.
tools/sprixen/.music-ids.json
tools/sprixen/.boss-sprites.json
tools/sprixen/.boss-anims.json
tools/sprixen/.cg-*
# Local-only Flux worker (never deployed).
tools/flux/.wrangler/
tools/flux/node_modules/
tools/flux/worker-configuration.d.ts
tools/sprixen/.hulls-state.json
tools/sprixen/.map-state.json

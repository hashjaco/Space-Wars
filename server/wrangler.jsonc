{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "space-case-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "BOARD", "class_name": "Board" },
      { "name": "VAULT", "class_name": "Vault" }
    ]
  },
  // SQLite-backed, which is the only option for new classes. Nothing is written to a Room: it
  // exists only while people are connected to it, and a match that has to survive the room being
  // evicted is a match everyone has already left. Board and Vault are the opposite -- storage is
  // the whole point of both -- which is why they are separate classes rather than more routes on
  // the room: a hibernating room must stay disposable.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Board", "Vault"] }
  ]
}

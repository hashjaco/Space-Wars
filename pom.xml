<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.hashimjacobs</groupId>
  <artifactId>space-case</artifactId>
  <version>2.5</version>
  <packaging>jar</packaging>
  <name>Space Case</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- JavaFX ships separately from the JDK since Java 11. Its major version must
         track the JDK it runs on: JavaFX 26 requires a JDK 26 runtime. -->
    <javafx.version>26.0.2</javafx.version>
    <!-- Version tracks the SDL release it wraps: 2.30.0.0 is SDL 2.30.0. -->
    <jamepad.version>2.30.0.0</jamepad.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-media</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- JavaFX has no controller API. Jamepad wraps SDL's, and carries every platform's
         native in the one artifact, so the per-OS release jars need no extra profile. -->
    <dependency>
      <groupId>com.badlogicgames.jamepad</groupId>
      <artifactId>jamepad</artifactId>
      <version>${jamepad.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.hashimjacobs.spacecase.Main</mainClass>
          <options>
            <!-- JavaFX loads native libs and binds native methods. Unapproved native
                 access only warns today but is slated to be blocked outright. Jamepad does
                 the same from the classpath, which is the unnamed module. -->
            <option>--enable-native-access=ALL-UNNAMED,javafx.graphics,javafx.media</option>
          </options>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.hashimjacobs.spacecase.Launcher</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Builds a single runnable jar carrying this platform's JavaFX runtime. Activated by the
      release workflow, which runs it once per operating system, since the natives differ.
    -->
    <profile>
      <id>shaded</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <phase>package</phase>
                <goals>
                  <goal>shade</goal>
                </goals>
                <configuration>
                  <shadedArtifactAttached>true</shadedArtifactAttached>
                  <shadedClassifierName>all</shadedClassifierName>
                  <createDependencyReducedPom>false</createDependencyReducedPom>
                  <transformers>
                    <transformer
                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                      <mainClass>com.hashimjacobs.spacecase.Launcher</mainClass>
                      <manifestEntries>
                        <!-- JavaFX loads native libraries; granting access here keeps the
                             launch quiet and survives native access being enforced. -->
                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                      </manifestEntries>
                    </transformer>
                  </transformers>
                  <filters>
                    <filter>
                      <artifact>*:*</artifact>
                      <excludes>
                        <!-- Merged jars cannot keep their module descriptors, and bundled
                             signatures no longer match once the archive is rebuilt. -->
                        <exclude>module-info.class</exclude>
                        <exclude>META-INF/*.SF</exclude>
                        <exclude>META-INF/*.DSA</exclude>
                        <exclude>META-INF/*.RSA</exclude>
                      </excludes>
                    </filter>
                  </filters>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Native iOS and Android builds, via GraalVM native-image.

      Everything here is a pin backwards, and the versions are not ours to choose. Gluon builds
      its own GraalVM fork and its own static JavaFX libraries, and both lag the JDK badly:
      substrate's DEFAULT_JAVAFX_STATIC_SDK_VERSION is "21-ea+11.3", and the newest GraalVM in
      gluonhq/graal is a JDK 23 dev build from September 2024 (the last Final build is JDK 17, from
      2022). So mobile gets JavaFX 21 and release 17 whether we like it or not.

      Contained in a profile rather than applied to the project, because it does not have to
      spread: the whole suite passes at -Djavafx.version=21.0.6 -Dmaven.compiler.release=17, so
      nothing in this codebase actually needs 26. Desktop keeps the current runtime and the
      installers are untouched.

      Deliberately no dependency surgery. jamepad carries desktop-only SDL natives and javafx.media
      is unsupported on both mobile targets, but native-image only compiles what it can reach, so
      an entry point that never touches SoundBank or Gamepad leaves both out of the image without
      the classpath having to differ. If that turns out to be wrong, splitting them into a desktop
      profile is the next move: activate it on the absence of a property, never activeByDefault,
      which any -P on the command line silently disables.

      Build with:  mvn -Pmobile -Dgluonfx.target=android gluonfx:build gluonfx:package
      Requires GRAALVM_HOME pointing at a Gluon GraalVM build, plus the Android SDK/NDK or Xcode.
    -->
    <profile>
      <id>mobile</id>
      <properties>
        <javafx.version>21.0.6</javafx.version>
        <!-- 17, because Android needs it: Gluon's java23 GraalVM lacks an option its own Android
             build passes (gluonfx-maven-plugin issue 539), which leaves the java17 one. net.Http
             is what keeps the source compiling here while the desktop keeps its JDK 21 calls. -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- host builds a native binary for this machine, which is the cheapest way to find out
             whether native-image can compile the project at all before any device is involved. -->
        <gluonfx.target>host</gluonfx.target>
        <gluonfx.mainClass>com.hashimjacobs.spacecase.Launcher</gluonfx.mainClass>
        <attach.version>4.0.26</attach.version>
      </properties>
      <!-- Android audio. Java Sound and JavaFX media cannot run there; Gluon Attach plays through
           Android's own SoundPool and MediaPlayer. Profile-only, so the desktop never ships it. -->
      <dependencies>
        <dependency>
          <groupId>com.gluonhq.attach</groupId>
          <artifactId>audio</artifactId>
          <version>${attach.version}</version>
        </dependency>
        <dependency>
          <groupId>com.gluonhq.attach</groupId>
          <artifactId>lifecycle</artifactId>
          <version>${attach.version}</version>
        </dependency>
        <dependency>
          <groupId>com.gluonhq.attach</groupId>
          <artifactId>storage</artifactId>
          <version>${attach.version}</version>
        </dependency>
        <dependency>
          <groupId>com.gluonhq.attach</groupId>
          <artifactId>util</artifactId>
          <version>${attach.version}</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <!-- src/android/java: the code that compiles only against the Attach libraries above. -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>android-sources</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/android/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.gluonhq</groupId>
            <artifactId>gluonfx-maven-plugin</artifactId>
            <version>1.0.29</version>
            <configuration>
              <target>${gluonfx.target}</target>
              <mainClass>${gluonfx.mainClass}</mainClass>
              <!--
                There is no reflection anywhere in src/main, but JavaFX itself uses it to start:
                Application.launch(String...) calls Class.forName on whatever class called it, so
                without this the native binary boots the Gluon VM, boots JavaFX, and then dies with
                ClassNotFoundException on our own entry point. Nothing else in the game needs
                registering, which is why this list is one line rather than a file.
              -->
              <!-- TEMPORARY while the Shield build is tuned: every collection to the log, to see
                   whether the 100 ms hitches every few seconds are the garbage collector. -->
              <nativeImageArgs>
                <arg>-R:+PrintGC</arg>
                <!-- Measured on a Shield: about 20 MB a second of garbage against a young
                     generation of about 40 MB, so a collection every two seconds and a full one,
                     60 to 90 ms, every eight or so. A larger young generation makes both rarer,
                     but the Shield has 3 GB, the game is already around 650 MB of it, and at 160 MB
                     Android killed it within seconds of Home. 96 is the compromise until the game
                     makes less garbage. -->
                <arg>-R:MaxNewSize=96m</arg>
              </nativeImageArgs>
              <!-- Attach services the game calls; the plugin adds each one's Android half. -->
              <attachList>
                <list>audio</list>
                <list>lifecycle</list>
                <list>storage</list>
              </attachList>
              <reflectionList>
                <!-- PlatformAudio finds the Android audio by name. -->
                <list>com.hashimjacobs.spacecase.asset.AttachAudio</list>
                <list>com.hashimjacobs.spacecase.AttachLifecycle</list>
                <list>com.hashimjacobs.spacecase.Main</list>
                <!-- JavaFX finds the renderer for every effect and canvas blend mode by class
                     name, and its own native-image config lists only a handful. Each one missing
                     threw on the render thread: SCREEN left the whole screen black, Crop drew the
                     arena shrunk into a corner. All of them, so the next effect someone adds is not
                     the next crash on a TV. -->
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_ADDPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_BLUEPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_COLOR_BURNPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_COLOR_DODGEPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_DARKENPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_DIFFERENCEPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_EXCLUSIONPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_GREENPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_HARD_LIGHTPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_LIGHTENPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_MULTIPLYPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_OVERLAYPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_REDPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_SCREENPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_SOFT_LIGHTPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_SRC_ATOPPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_SRC_INPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_SRC_OUTPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_SRC_OVERPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSBrightpassPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSColorAdjustPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSDisplacementMapPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSInvertMaskPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSLinearConvolvePeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSLinearConvolveShadowPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSPerspectiveTransformPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSPhongLighting_DISTANTPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSPhongLighting_POINTPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSPhongLighting_SPOTPeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPSSepiaTonePeer</list>
                <list>com.sun.scenario.effect.impl.prism.ps.PPStoPSWDisplacementMapPeer</list>
                <list>com.sun.scenario.effect.impl.prism.PrCropPeer</list>
                <list>com.sun.scenario.effect.impl.prism.PrFloodPeer</list>
                <list>com.sun.scenario.effect.impl.prism.PrMergePeer</list>
                <list>com.sun.scenario.effect.impl.prism.PrReflectionPeer</list>
              </reflectionList>
              <!--
                GraalVM keeps only the resources it is told to. Gluon's defaults cover images,
                fonts, css and a dozen other things, but no audio extension at all, so the first
                native build started, drew the game, and then threw "Missing bundled audio" for
                every effect and every track. The sprites were never at risk; png is on the default
                list. txt is here for gamecontrollerdb.
              -->
              <resourcesList>
                <!--
                  Doubled backslashes on purpose. The plugin copies these into
                  resourceconfig.json verbatim without escaping them, so a single backslash
                  produces invalid JSON and native-image fails to parse its own config.
                -->
                <list>.*\\.wav$</list>
                <list>.*\\.mp3$</list>
                <list>.*\\.txt$</list>
              </resourcesList>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      Signs the Android build with a fixed key, when one is supplied.

      Without it Gluon signs each build with a throwaway debug key, and Android refuses to install a
      build over one signed differently: every update meant uninstalling first, which wipes saves
      and takes the tile off the TV's home row. Active only when the keystore's path is in the
      environment, which is what .github/workflows/android.yml does from repository secrets; a
      build without it is signed as before. The key itself is never in this repository.
    -->
    <profile>
      <id>android-signed</id>
      <activation>
        <property>
          <name>env.GLUON_ANDROID_KEYSTOREPATH</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>com.gluonhq</groupId>
            <artifactId>gluonfx-maven-plugin</artifactId>
            <version>1.0.29</version>
            <configuration>
              <releaseConfiguration>
                <providedKeyStorePath>${env.GLUON_ANDROID_KEYSTOREPATH}</providedKeyStorePath>
                <providedKeyStorePassword>${env.GLUON_ANDROID_KEYSTORE_PASSWORD}</providedKeyStorePassword>
                <providedKeyAlias>${env.GLUON_ANDROID_KEYALIAS}</providedKeyAlias>
                <providedKeyAliasPassword>${env.GLUON_ANDROID_KEYALIAS_PASSWORD}</providedKeyAliasPassword>
              </releaseConfiguration>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.hashimjacobs</groupId>
  <artifactId>space-case</artifactId>
  <version>2.0</version>
  <packaging>jar</packaging>
  <name>Space Case</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- JavaFX ships separately from the JDK since Java 11. Its major version must
         track the JDK it runs on: JavaFX 26 requires a JDK 26 runtime. -->
    <javafx.version>26.0.2</javafx.version>
    <!-- Version tracks the SDL release it wraps: 2.30.0.0 is SDL 2.30.0. -->
    <jamepad.version>2.30.0.0</jamepad.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-media</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- JavaFX has no controller API. Jamepad wraps SDL's, and carries every platform's
         native in the one artifact, so the per-OS release jars need no extra profile. -->
    <dependency>
      <groupId>com.badlogicgames.jamepad</groupId>
      <artifactId>jamepad</artifactId>
      <version>${jamepad.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.hashimjacobs.spacecase.Main</mainClass>
          <options>
            <!-- JavaFX loads native libs and binds native methods. Unapproved native
                 access only warns today but is slated to be blocked outright. Jamepad does
                 the same from the classpath, which is the unnamed module. -->
            <option>--enable-native-access=ALL-UNNAMED,javafx.graphics,javafx.media</option>
          </options>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.hashimjacobs.spacecase.Launcher</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Builds a single runnable jar carrying this platform's JavaFX runtime. Activated by the
      release workflow, which runs it once per operating system, since the natives differ.
    -->
    <profile>
      <id>shaded</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <phase>package</phase>
                <goals>
                  <goal>shade</goal>
                </goals>
                <configuration>
                  <shadedArtifactAttached>true</shadedArtifactAttached>
                  <shadedClassifierName>all</shadedClassifierName>
                  <createDependencyReducedPom>false</createDependencyReducedPom>
                  <transformers>
                    <transformer
                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                      <mainClass>com.hashimjacobs.spacecase.Launcher</mainClass>
                      <manifestEntries>
                        <!-- JavaFX loads native libraries; granting access here keeps the
                             launch quiet and survives native access being enforced. -->
                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                      </manifestEntries>
                    </transformer>
                  </transformers>
                  <filters>
                    <filter>
                      <artifact>*:*</artifact>
                      <excludes>
                        <!-- Merged jars cannot keep their module descriptors, and bundled
                             signatures no longer match once the archive is rebuilt. -->
                        <exclude>module-info.class</exclude>
                        <exclude>META-INF/*.SF</exclude>
                        <exclude>META-INF/*.DSA</exclude>
                        <exclude>META-INF/*.RSA</exclude>
                      </excludes>
                    </filter>
                  </filters>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Native iOS and Android builds, via GraalVM native-image.

      Everything here is a pin backwards, and the versions are not ours to choose. Gluon builds
      its own GraalVM fork and its own static JavaFX libraries, and both lag the JDK badly:
      substrate's DEFAULT_JAVAFX_STATIC_SDK_VERSION is "21-ea+11.3", and the newest GraalVM in
      gluonhq/graal is a JDK 23 dev build from September 2024 (the last Final build is JDK 17, from
      2022). So mobile gets JavaFX 21 and release 17 whether we like it or not.

      Contained in a profile rather than applied to the project, because it does not have to
      spread: the whole suite passes at -Djavafx.version=21.0.6 -Dmaven.compiler.release=17, so
      nothing in this codebase actually needs 26. Desktop keeps the current runtime and the
      installers are untouched.

      Deliberately no dependency surgery. jamepad carries desktop-only SDL natives and javafx.media
      is unsupported on both mobile targets, but native-image only compiles what it can reach, so
      an entry point that never touches SoundBank or Gamepad leaves both out of the image without
      the classpath having to differ. If that turns out to be wrong, splitting them into a desktop
      profile is the next move: activate it on the absence of a property, never activeByDefault,
      which any -P on the command line silently disables.

      Build with:  mvn -Pmobile -Dgluonfx.target=android gluonfx:build gluonfx:package
      Requires GRAALVM_HOME pointing at a Gluon GraalVM build, plus the Android SDK/NDK or Xcode.
    -->
    <profile>
      <id>mobile</id>
      <properties>
        <javafx.version>21.0.6</javafx.version>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- host builds a native binary for this machine, which is the cheapest way to find out
             whether native-image can compile the project at all before any device is involved. -->
        <gluonfx.target>host</gluonfx.target>
        <gluonfx.mainClass>com.hashimjacobs.spacecase.Launcher</gluonfx.mainClass>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>com.gluonhq</groupId>
            <artifactId>gluonfx-maven-plugin</artifactId>
            <version>1.0.29</version>
            <configuration>
              <target>${gluonfx.target}</target>
              <mainClass>${gluonfx.mainClass}</mainClass>
              <!--
                There is no reflection anywhere in src/main, but JavaFX itself uses it to start:
                Application.launch(String...) calls Class.forName on whatever class called it, so
                without this the native binary boots the Gluon VM, boots JavaFX, and then dies with
                ClassNotFoundException on our own entry point. Nothing else in the game needs
                registering, which is why this list is one line rather than a file.
              -->
              <reflectionList>
                <list>com.hashimjacobs.spacecase.Main</list>
              </reflectionList>
              <!--
                GraalVM keeps only the resources it is told to. Gluon's defaults cover images,
                fonts, css and a dozen other things, but no audio extension at all, so the first
                native build started, drew the game, and then threw "Missing bundled audio" for
                every effect and every track. The sprites were never at risk; png is on the default
                list. txt is here for gamecontrollerdb.
              -->
              <resourcesList>
                <!--
                  Doubled backslashes on purpose. The plugin copies these into
                  resourceconfig.json verbatim without escaping them, so a single backslash
                  produces invalid JSON and native-image fails to parse its own config.
                -->
                <list>.*\\.wav$</list>
                <list>.*\\.mp3$</list>
                <list>.*\\.txt$</list>
              </resourcesList>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
